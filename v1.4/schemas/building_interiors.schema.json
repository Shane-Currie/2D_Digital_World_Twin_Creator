{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator-authored building interiors",
  "type": "object",
  "required": ["schema_version", "kind", "buildings"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "creator_building_interiors" },
    "buildings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["feature_id", "floors"],
        "properties": {
          "feature_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "floors": {
            "type": "array", "minItems": 1, "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["id", "name", "level", "layout_source", "survey_status", "width_metres", "height_metres", "grid_metres", "footprint_scale", "boundary_metres", "holes_metres", "rooms", "furniture", "entry_links"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string" },
                "level": { "type": "integer", "minimum": 0, "maximum": 19 },
                "layout_source": { "enum": ["creator_blank_from_osm_footprint", "creator_copy_of_footprint_shape"] },
                "survey_status": { "enum": ["not_surveyed", "creator_adjusted"] },
                "width_metres": { "type": "number", "exclusiveMinimum": 0.25, "maximum": 2000 },
                "height_metres": { "type": "number", "exclusiveMinimum": 0.25, "maximum": 2000 },
                "grid_metres": { "type": "number", "exclusiveMinimum": 0 },
                "footprint_scale": { "type": "number", "minimum": 1, "maximum": 3 },
                "boundary_metres": { "$ref": "#/$defs/ring" },
                "holes_metres": { "type": "array", "items": { "$ref": "#/$defs/ring" } },
                "rooms": { "type": "array" },
                "furniture": { "type": "array" },
                "entry_links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "exterior_entrance_id", "floor_id", "spawn_x_metres", "spawn_y_metres", "placement_source"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "exterior_entrance_id": { "type": "string", "minLength": 1 },
                      "floor_id": { "const": "ground_floor" },
                      "spawn_x_metres": { "type": "number" },
                      "spawn_y_metres": { "type": "number" },
                      "placement_source": { "const": "creator_selected" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "ring": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
  }
}
