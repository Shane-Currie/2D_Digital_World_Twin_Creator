{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator-imported interior furniture catalogue",
  "type": "object",
  "required": ["schema_version", "kind", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "creator_interior_furniture_catalog" },
    "updated_utc": { "type": "string" },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "name", "object_type", "category", "size_metres", "fill", "outline", "collision", "catalog_source", "image_path", "original_file_name", "imported_utc"],
        "properties": {
          "id": { "type": "string", "pattern": "^custom_[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "object_type": { "type": "string", "minLength": 1, "maxLength": 48 },
          "category": { "const": "My creations" },
          "usage_categories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 48, "not": { "const": "All items" } }
          },
          "size_metres": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 0.1, "maximum": 20 }, { "type": "number", "minimum": 0.1, "maximum": 20 }], "minItems": 2, "maxItems": 2 },
          "fill": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "outline": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "collision": { "const": true },
          "catalog_source": { "const": "creator_imported" },
          "image_path": { "type": "string", "pattern": "^assets/interiors/furniture/[A-Za-z0-9_.-]+\\.(png|jpg|jpeg|webp)$" },
          "original_file_name": { "type": "string" },
          "imported_utc": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
